OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_APPLICATION_CREDENTIALS=path_to_your_gcp_key.json

# ----- 모델 (core, src/just_make_it/config.py) -----
# OPENAI_IMAGE_QUALITY=medium
# DEFAULT_IMAGE_BACKEND=gpt-image-2.5-flare
# DEFAULT_TEXT_BACKEND=gpt-5.6-luna

# ----- 서비스 데이터 (service/db.py, service/storage.py) -----
# DB + 이미지. VM에서는 영구 디스크 경로, Docker는 볼륨 마운트 경로
DATA_DIR=./data
# 이미지 URL 앞부분 (프론트에서 접근 가능한 API 주소. VM에서는 외부 주소로 바꿀 것)
PUBLIC_BASE_URL=http://localhost:8000

# ----- 서빙 (src/just_make_it/serving/settings.py) -----
# core: 실제 생성 (OPENAI_API_KEY 필요) / mock: 키 없이 더미 이미지로 개발
IMAGE_BACKEND=core
# 비우면 core 기본 모델. Fallback·프리미엄은 비우면 꺼짐
# PRIMARY_IMAGE_MODEL=
# FALLBACK_IMAGE_MODEL=
# PREMIUM_IMAGE_MODEL=
# 동시에 처리할 생성 수 (API 모델 2~3, 로컬 GPU 모델 1)
PRIMARY_CONCURRENCY=1
# 생성 1건 제한 시간(초). 넘으면 재시도 없이 Fallback 또는 503
GENERATION_TIMEOUT_SECONDS=90
# 하루 생성 한도 (0이면 무제한), 그중 Fallback·프리미엄 한도
DAILY_JOB_LIMIT=300
EXTRA_DAILY_LIMIT=100
# 프론트 주소 (쉼표 없이 JSON 배열). VM 배포 시 프론트 도메인 추가
# CORS_ORIGINS=["http://localhost:3000"]
