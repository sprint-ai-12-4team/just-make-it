OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_APPLICATION_CREDENTIALS=path_to_your_gcp_key.json

# ----- 모델 (core, src/just_make_it/config.py) -----
# OpenAI 이미지 품질 (low / medium / high)
# OPENAI_IMAGE_QUALITY=medium
# Gemma를 돌리는 Ollama 주소. 도커에서는 http://ollama:11434
# OLLAMA_HOST=http://localhost:11434
# 로컬 모델(klein, Gemma)이 실패하면 OpenAI 모델(flare, luna)로 대신 만들지
# USE_FALLBACK=true
# 문구 작업이 끝나면 Gemma를 GPU에서 바로 내림(0) / 계속 올려 둠(-1)
# klein과 같이 올라가는지 VM에서 재서 정함 → python -m just_make_it.serving.gpu_check (사용법은 파일 맨 위)
# 0이면 Gemma 호출마다 다시 올리므로 아래 COPY·DETAIL 타임아웃을 gpu_check 추천값으로 늘릴 것
# GEMMA_KEEP_ALIVE=0
# GPU 메모리가 부족할 때만 true (메모리는 아끼지만 느려짐)
# KLEIN_CPU_OFFLOAD=false
# klein 가중치가 Hugging Face 로그인을 요구하면 토큰 필요
# HF_TOKEN=

# ----- 서비스 데이터 (service/db.py, service/storage.py) -----
# DB + 이미지. VM에서는 영구 디스크 경로, Docker는 볼륨 마운트 경로
DATA_DIR=./data
# 이미지 URL 앞부분. 로컬은 http://localhost:8000
# VM + Vercel 프록시에서는 /api/backend (상대 경로 → 어느 프론트 도메인에서나 동작)
PUBLIC_BASE_URL=http://localhost:8000

# ----- 서빙 (src/just_make_it/serving/settings.py) -----
# core: 실제 생성 / mock: 키·GPU 없이 더미 이미지로 개발
IMAGE_BACKEND=core
# "빠르게"(로컬 klein) 대기가 길거나 준비 안 됐을 때 OpenAI로 넘길지
# QUEUE_FALLBACK=true
# /generate 안의 영어 묘사용 문구 품질 (basic = Gemma, natural = luna)
# GENERATE_TEXT_QUALITY=basic
# 로컬 GPU 대기열에서 동시에 처리할 수 (klein은 1)
PRIMARY_CONCURRENCY=1
# 생성 1건 제한 시간(초). 넘으면 재시도 없이 Fallback 또는 503
GENERATION_TIMEOUT_SECONDS=90
# 문구 추천(/copies), 상세페이지 문구 5칸 제한 시간(초). 넘으면 core의 Gemma·OpenAI 호출도 멈춤
# COPY_TIMEOUT_SECONDS=60
# DETAIL_TEXT_TIMEOUT_SECONDS=90
# /generate가 결과를 기다리는 최대 시간(초). Vercel 프록시 한도(120초)보다 짧게
# GENERATE_WAIT_SECONDS=110
# 하루 생성 한도 (0이면 무제한), 그중 OpenAI(Fallback·더 정교하게) 한도
DAILY_JOB_LIMIT=300
EXTRA_DAILY_LIMIT=100
# OpenAI 하루 금액 상한(달러). 넘으면 OpenAI(Fallback·더 정교하게·core 폴백)를 막고 로컬로만 처리
# 생성 기록의 cost_usd 합계 기준 (/copies 문구 비용은 기록이 없어 빠짐). 0이면 끔
# OPENAI_DAILY_BUDGET_USD=3.0
# 프론트 주소 (JSON 배열). 로컬 직접 호출용. Vercel 프록시를 쓰면 필요 없음
# CORS_ORIGINS=["http://localhost:3000"]
